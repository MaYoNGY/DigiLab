# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (Copia este archivo como .env)
# =============================================================================

# Conexión local a PostgreSQL (Docker / WSL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=tu_usuario_postgres
DB_PASSWORD=tu_password_seguro
DB_NAME=digilab_db

# Secretos de Autenticación
JWT_SECRET=reemplazar_por_llave_secreta_larga
PASSWORD_SALT=reemplazar_por_salt_seguro

# URL completa para despliegue en Vercel (Neon / Supabase / Railway)
# DATABASE_URL=postgresql://usuario:password@host:5432/dbname?sslmode=require

PORT=3000
